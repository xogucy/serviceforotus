{
  "info": {
    "_postman_id": "3f83f785-0a8b-4c4d-a80d-64d60c1326af",
    "name": "serviceforotus users CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://arch.homework"
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Healthcheck",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Health status is OK\", function () {",
              "  pm.expect(pm.response.json().status).to.eql(\"OK\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"otus-{{$timestamp}}\",\n  \"firstName\": \"Ivan\",\n  \"lastName\": \"Petrov\",\n  \"email\": \"otus-{{$timestamp}}@example.com\",\n  \"phone\": \"+79990000000\"\n}"
        },
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Created user has id\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.id).to.be.a(\"number\");",
              "  pm.collectionVariables.set(\"userId\", json.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get user",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returned requested user\", function () {",
              "  pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"userId\")));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update user",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Petr\",\n  \"lastName\": \"Ivanov\",\n  \"phone\": \"+79991112233\"\n}"
        },
        "url": "{{baseUrl}}/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"User was updated\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.firstName).to.eql(\"Petr\");",
              "  pm.expect(json.lastName).to.eql(\"Ivanov\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete user",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 204\", function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
